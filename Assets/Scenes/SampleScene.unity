  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\U0001F3CE\uFE0F Ultimate Racing Challenge \u2013 Are You Fast Enough?
    \U0001F3C1\n\U0001F525 Get Ready to Race!\n\nPress E to start your engine (but
    wait 5 seconds before the race begins!).\n\nControl your speed and handling with
    Arrow Keys.\n\nZoom in/out using the Scroll Wheel, and move the camera with Right
    Click.\n\nWant a different view? Use Left Click for a 360\xB0 spin or press C
    to switch between top, front, and back views!\n\n\u23F3 The Challenge:\n\U0001F3C6
    Your mission is simple \u2013 Complete 3 laps within 3 minutes! But it\u2019s
    all about speed and precision.\n\u2714\uFE0F You start at Lap 1, and each time
    you cross the white line, your lap counter increases.\n\U0001F6A6 Make it to
    Lap 3 before time runs out, and you WIN!\n\n\u26A0\uFE0F The Clock is Ticking!\n\nIf
    the timer hits 0, it's Game Over.\n\nThink fast, drive faster! Manage your time
    and speed wisely.\n\n\U0001F539 Need help? Click the Help Icon.\n\u23F8\uFE0F
    Want to take a break? Hit the Pause Icon anytime.\n\n\U0001F3C1 Are you ready
    to prove you're the fastest racer on the track? Let\u2019s go! \U0001F697\U0001F4A8"
